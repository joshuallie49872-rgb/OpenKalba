    "import os, sys, json": "운영 체제, sys, json 가져오기",
    "from google.cloud import translate_v3 as t": "google.cloud에서translate_v3을 t로 가져오기",
    "def load(p):": "정의 부하(p):",
    "with open(p, \"r\", encoding=\"utf-8\") as f:": "open(p, \"r\", 인코딩=\"utf-8\")을 f로 사용:",
    "return json.load(f)": "json.load(f)를 반환합니다.",
    "def save(p, obj):": "def 저장(p, obj):",
    "with open(p, \"w\", encoding=\"utf-8\") as f:": "open(p, \"w\", 인코딩=\"utf-8\")을 f로 사용:",
    "json.dump(obj, f, ensure_ascii=False, indent=2)": "json.dump(obj, f, verify_ascii=False, 들여쓰기=2)",
    "def gtranslate(client, parent, texts, target=\"en\", source=None):": "def gtranslate(클라이언트, 부모, 텍스트, target=\"en\", 소스=없음):",
    "# Google v3 limits: keep batches reasonable": "# Google v3 제한: 배치를 합리적으로 유지",
    "req = dict(parent=parent, contents=texts, mime_type=\"text/plain\", target_language_code=target)": "req = dict(부모=부모, 내용=텍스트, mime_type=\"텍스트/일반\", target_언어_코드=대상)",
    "if source:": "소스인 경우:",
    "req[\"source_language_code\"] = source": "req[\"source_lang_code\"] = 소스",
    "resp = client.translate_text(**req)": "resp = client.translate_text(**req)",
    "return [x.translated_text for x in resp.translations]": "[resp.translations의 x에 대한 x.translated_text]를 반환합니다.",
    "def main():": "데프 메인():",
    "if len(sys.argv) < 2:": "len(sys.argv) < 2인 경우:",
    "print(\"Usage: py tools/add_missing_keys_to_en_overlay_gloss.py <learn_lang> [missing_keys_txt]\")": "print(\"사용법: py tools/add_missing_keys_to_en_overlay_gloss.py <learn_lang> [missing_keys_txt]\")",
    "sys.exit(2)": "sys.exit(2)",
    "learn = sys.argv[1].strip().lower()": "학습 = sys.argv[1].strip().lower()",
    "missing_txt = sys.argv[2] if len(sys.argv) >= 3 else None": "Missing_txt = sys.argv[2] if len(sys.argv) >= 3 else 없음",
    "# read missing keys list (either file or stdin)": "# 누락된 키 목록을 읽습니다(파일 또는 표준 입력).",
    "if missing_txt:": "missing_txt인 경우:",
    "keys = [line.strip() for line in open(missing_txt, \"r\", encoding=\"utf-8\") if line.strip()]": "키 = [line.strip() for line in open(missing_txt, \"r\", 인코딩=\"utf-8\") if line.strip()]",
    "else:": "그렇지 않으면:",
    "keys = [line.strip() for line in sys.stdin.read().splitlines() if line.strip()]": "키 = [line.strip()의 라인에 대한 sys.stdin.read().splitlines() if line.strip()]",
    "overlay_path = f\"courses/{learn}/overlays/en.json\"": "overlay_path = f\"courses/{learn}/overlays/en.json\"",
    "if not os.path.exists(overlay_path):": "그렇지 않은 경우 os.path.exists(overlay_path):",
    "raise SystemExit(f\"Missing: {overlay_path}\")": "SystemExit(f\"누락: {overlay_path}\")를 발생시킵니다.",
    "d = load(overlay_path)": "d = 로드(overlay_path)",
    "gloss = d.get(\"gloss\", {}) if isinstance(d.get(\"gloss\"), dict) else {}": "Gloss = d.get(\"gloss\", {}) if isinstance(d.get(\"gloss\"), dict) else {}",
    "ui = d.get(\"ui\", {}) if isinstance(d.get(\"ui\"), dict) else {}": "ui = d.get(\"ui\", {}) if isinstance(d.get(\"ui\"), dict) else {}",
    "# Google setup": "# 구글 설정",
    "project_id = os.environ.get(\"GOOGLE_CLOUD_PROJECT\") or json.load(open(os.environ[\"GOOGLE_APPLICATION_CREDENTIALS\"], \"r\", encoding=\"utf-8\"))[\"project_id\"]": "project_id = os.environ.get(\"GOOGLE_CLOUD_PROJECT\") 또는 json.load(open(os.environ[\"GOOGLE_APPLICATION_CREDENTIALS\"], \"r\", 인코딩=\"utf-8\"))[\"project_id\"]",
    "parent = f\"projects/{project_id}/locations/global\"": "상위 = f\"프로젝트/{project_id}/위치/글로벌\"",
    "client = t.TranslationServiceClient()": "클라이언트 = t.TranslationServiceClient()",
    "# Add missing keys: prefer gloss, but if it looks like UI text we also add to ui": "# 누락된 키 추가: 광택을 선호하지만 UI 텍스트처럼 보이면 ui에도 추가합니다.",
    "to_translate_lt = []": "to_translate_lt = []",
    "to_translate_auto = []": "to_translate_auto = []",
    "mapping = {}": "매핑 = {}",
    "def looks_lithuanian(s):": "def Looks_리투아니아어(들):",
    "return any(ch in s for ch in \"ąčęėįšųūžĄČĘĖĮŠŲŪŽ\")": "임의의 항목을 반환합니다(ch in s for ch in \"ąčęėįšųūžĄцĘĖĮŠŲŪŽ\")",
    "for k in keys:": "키의 k에 대해:",
    "if k in gloss or k in ui:": "k가 광택이거나 k가 ui인 경우:",
    "# Put everything into gloss (lesson strings), and ALSO into ui if it’s a UI-ish phrase": "# 모든 것을 글로스(레슨 문자열)에 넣고, UI 관련 문구인 경우에는 ui에도 넣습니다.",
    "mapping[k] = None": "매핑[k] = 없음",
    "if looks_lithuanian(k):": "Looks_리투아니아어(k)인 경우:",
    "to_translate_lt.append(k)": "to_translate_lt.append(k)",
    "# could be English already; translate auto->en (harmless)": "# 이미 영어일 수도 있습니다. 자동->en 번역(무해함)",
    "to_translate_auto.append(k)": "to_translate_auto.append(k)",
    "# Translate in batches": "# 일괄 번역",
    "def batched(lst, n=50):": "def 일괄 처리(lst, n=50):",
    "for i in range(0, len(lst), n):": "i가 범위(0, len(lst), n)에 있는 경우:",
    "yield lst[i:i+n]": "산출량 lst[i:i+n]",
    "for batch in batched(to_translate_lt, 50):": "일괄 처리(to_translate_lt, 50)의 경우:",
    "out = gtranslate(client, parent, batch, target=\"en\", source=\"lt\")": "out = gtranslate(클라이언트, 상위, 배치, target=\"en\", 소스=\"lt\")",
    "for k, v in zip(batch, out):": "k, v in zip(배치, 출력):",
    "mapping[k] = v": "매핑[k] = v",
    "for batch in batched(to_translate_auto, 50):": "일괄 처리(to_translate_auto, 50)의 경우:",
    "out = gtranslate(client, parent, batch, target=\"en\", source=None)": "out = gtranslate(클라이언트, 상위, 배치, target=\"en\", 소스=없음)",
    "added = 0": "추가됨 = 0",
    "for k, v in mapping.items():": "mapping.items()의 k, v에 대해:",
    "if v is None:": "v가 없음인 경우:",
    "gloss[k] = v": "광택[k] = v",
    "added += 1": "+= 1 추가됨",
    "d[\"gloss\"] = gloss": "d[\"광택\"] = 광택",
    "d[\"ui\"] = ui": "d[\"ui\"] = UI",
    "save(overlay_path, d)": "저장(overlay_path, d)",
    "print(f\"[{learn}] added_to_gloss={added} -> {overlay_path}\")": "print(f\"[{learn}] added_to_gloss={추가} -> {overlay_path}\")",
    "if __name__ == \"__main__\":": "__name__ == \"__main__\"인 경우:",
    "main()": "놀다()"
  }
