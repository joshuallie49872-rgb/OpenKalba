    "import os, sys, json": "import os, sys, json",
    "from google.cloud import translate_v3 as t": "from google.cloud import translate_v3 as t",
    "def load(p):": "def load(p):",
    "with open(p, \"r\", encoding=\"utf-8\") as f:": "with open(p, \"r\", encoding=\"utf-8\") as f:",
    "return json.load(f)": "return json.load(f)",
    "def save(p, obj):": "def save(p, obj):",
    "with open(p, \"w\", encoding=\"utf-8\") as f:": "with open(p, \"w\", encoding=\"utf-8\") as f:",
    "json.dump(obj, f, ensure_ascii=False, indent=2)": "json.dump(obj, f, ensure_ascii=False, indent=2)",
    "def gtranslate(client, parent, texts, target=\"en\", source=None):": "def gtranslate(client, parent, texts, target=\"en\", source=None):",
    "# Google v3 limits: keep batches reasonable": "# Google v3 limits: keep batches reasonable",
    "req = dict(parent=parent, contents=texts, mime_type=\"text/plain\", target_language_code=target)": "req = dict(parent=parent, contents=texts, mime_type=\"text/plain\", target_language_code=target)",
    "if source:": "if source:",
    "req[\"source_language_code\"] = source": "req[\"source_language_code\"] = source",
    "resp = client.translate_text(**req)": "resp = client.translate_text(**req)",
    "return [x.translated_text for x in resp.translations]": "return [x.translated_text for x in resp.translations]",
    "def main():": "def main():",
    "if len(sys.argv) < 2:": "if len(sys.argv) < 2:",
    "print(\"Usage: py tools/add_missing_keys_to_en_overlay_gloss.py <learn_lang> [missing_keys_txt]\")": "print(\"Usage: py tools/add_missing_keys_to_en_overlay_gloss.py <learn_lang> [missing_keys_txt]\")",
    "sys.exit(2)": "sys.exit(2)",
    "learn = sys.argv[1].strip().lower()": "learn = sys.argv[1].strip().lower()",
    "missing_txt = sys.argv[2] if len(sys.argv) >= 3 else None": "missing_txt = sys.argv[2] if len(sys.argv) >= 3 else None",
    "# read missing keys list (either file or stdin)": "# read missing keys list (either file or stdin)",
